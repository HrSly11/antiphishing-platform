APP_ENV=development
PROJECT_NAME="Antiphishing Platform"
API_V1_STR=/api/v1

# PostgreSQL 16/18 with pg_trgm
DATABASE_URL=postgresql+asyncpg://postgres:12345@127.0.0.1:5432/antiphishing_db

# JWT & Cryptographic Signing Secrets (generate via python -m app.scripts.rotate_secrets)
SECRET_KEY=replace-with-64-char-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Service-to-Service Keys (MTA Gateway & n8n SOAR)
GATEWAY_API_KEY=replace-with-gateway-api-key
N8N_SERVICE_KEY=replace-with-n8n-service-key
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=replace-with-n8n-hmac-secret

# Detection & Bounded Network Enrichment
ENRICHMENT_ENABLED=true
ENRICHMENT_TIMEOUT_SECONDS=2.5
OFFICIAL_DOMAINS=["bancocentral.com"]

# On-Premise LLM (Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=6.0

# Optional Outbound SMTP (falls back to structured JSON logging when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=antiphishing@bancocentral.com
SMTP_STARTTLS=true

# Workers & Rate Limits
WORKERS_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
